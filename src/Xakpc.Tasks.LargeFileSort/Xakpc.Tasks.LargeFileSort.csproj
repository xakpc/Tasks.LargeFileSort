<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Xakpc.Tasks.LargeFileSort</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- several workers allocate millions of short-lived strings at once; a GC heap per core keeps them from contending -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Xakpc.Tasks.LargeFileSort.Tests" />
    <InternalsVisibleTo Include="Xakpc.Tasks.LargeFileSort.Benchmarks" />
  </ItemGroup>

</Project>
